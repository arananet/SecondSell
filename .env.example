# ── Application ────────────────────────────────────────
PORT=3000
# Set NODE_ENV=development for local HTTP dev (disables Secure cookie flag)
# Set NODE_ENV=production on Railway (enables Secure cookie — requires HTTPS)
NODE_ENV=production

# ── Basic Auth (protects the entire app) ───────────────
# Set these in Railway Variables — NEVER commit the real values to git
BASIC_AUTH_USER=REPLACE_WITH_USERNAME
BASIC_AUTH_PASS=REPLACE_WITH_PASSWORD

# Optional: dedicated secret for signing session cookies (recommended).
# If unset, the HMAC key is derived from BASIC_AUTH_USER:BASIC_AUTH_PASS.
# Generate with: openssl rand -base64 32
# SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET

# ── WordPress Site ──────────────────────────────────────
# Public URL of your WordPress installation (no trailing slash)
WP_URL=https://your-wordpress-site.com

# WordPress Application Password (for WP REST API — media uploads)
# Generate at: WP Admin → Users → Edit Profile → Application Passwords
# Name it "SecondSell" → copy the generated password
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── WooCommerce REST API ────────────────────────────────
# Used for product creation, category management.
# Generate at: WP Admin → WooCommerce → Settings → Advanced → REST API → Add key
# Set Description: "SecondSell", Permissions: Read/Write
WC_CONSUMER_KEY=ck_REPLACE_WITH_CONSUMER_KEY
WC_CONSUMER_SECRET=cs_REPLACE_WITH_CONSUMER_SECRET

# ── Anthropic / Claude API ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: override the default AI model (claude-sonnet-4-6)
# Examples: claude-haiku-4-5-20250315, claude-sonnet-4-20250514
# ANTHROPIC_MODEL=claude-sonnet-4-6
